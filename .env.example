# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (db.md 1.1 - PostgreSQL 15+)
DB_NAME=evenmore_erp
DB_USER=postgres
DB_PASSWORD=1234
DB_HOST=localhost
DB_PORT=5432

# JWT lifetimes (api.md 1.2)
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=14

# CORS (api-integration.md blocker 6) - the Vite dev origin
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Files (api.md 1.12). Backend "local" serves presigned-style URLs from this server.
FILE_STORAGE_BACKEND=local
FILE_MAX_BYTES=26214400
PMS_PROOF_MAX_BYTES=52428800

# Exchange rates (api.md 12.4) - fetched server-side, cached a day
EXCHANGE_RATE_URL=https://open.er-api.com/v6/latest/USD

# Outbound email (document /send/ delivery). Fill these in or channel=email
# fails with a clear EMAIL_NOT_CONFIGURED error instead of fake success.
# Example for Gmail: EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587,
# EMAIL_HOST_USER=you@gmail.com, EMAIL_HOST_PASSWORD=<app password>,
# EMAIL_USE_TLS=True, DEFAULT_FROM_EMAIL=you@gmail.com
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=

# Module toggle: HRMS-only dev mode (no code edits needed)
# True  -> only auth/admin/hrms (+ core platform) routes are mounted
# False -> full ERP routes are mounted
# PRODUCTION MUST USE HRMS_ONLY=False -- True hides every ERP module (404s).
HRMS_ONLY=False
# Optional exact override (comma-separated route keys):
# masters,inventory,sales,purchase,accounting,crm,pms,hrms,reports,dashboard,public
# Example HRMS + careers portal only:
# ENABLED_MODULES=hrms,public
# Example full ERP:
# ENABLED_MODULES=masters,inventory,sales,purchase,accounting,crm,pms,hrms,reports,dashboard,public


# E-Invoicing & E-Way Bill (PDF §20)
# Set EINVOICE_ENABLED=True to activate IRN and E-Way bill generation.
EINVOICE_ENABLED=False
# Provider adapter: 'sandbox-sim' (deterministic simulator), 'nic-direct', 'cleartax', 'gsp-generic'
EINVOICE_PROVIDER=sandbox-sim
# True for Sandbox/Staging NIC/GSP environment, False for Live Production
EINVOICE_SANDBOX_MODE=True
# NIC / GSP Gateway Endpoint
EINVOICE_BASE_URL=https://einv-apisandbox.nic.in
# GSP Credentials (provided by client's CA / GSP provider):
EINVOICE_CLIENT_ID=
EINVOICE_CLIENT_SECRET=
EINVOICE_USERNAME=
EINVOICE_PASSWORD=


# E-signature: DocuSign (CRM contract "Send for Signature")
# Sandbox setup: create a free developer account at developers.docusign.com,
# then Apps and Keys -> Add App -> generate an RSA keypair. Save the private
# key to a file (keep it out of git) and point DOCUSIGN_PRIVATE_KEY_PATH at it.
# Add redirect URI https://developers.docusign.com/platform/auth/consent and
# grant consent once (the first send returns the consent URL if needed).
# DOCUSIGN_INTEGRATION_KEY=
# DOCUSIGN_USER_ID=
# DOCUSIGN_ACCOUNT_ID=
# DOCUSIGN_PRIVATE_KEY_PATH=docusign_private.key
# DOCUSIGN_AUTH_SERVER=account-d.docusign.com
# DOCUSIGN_BASE_URL=https://demo.docusign.net/restapi
